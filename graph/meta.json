  "testi": {
    "TSUI": "F. Tsui, O. Karam, B. Bernal - Essentials of Software Engineering, 5th ed., Jones & Bartlett Learning, 2022",
    "HFDP": "E. Freeman, E. Robson, B. Bates, K. Sierra - Head First Design Patterns, 2nd ed., O'Reilly, 2020",
    "GOF": "E. Gamma, R. Helm, R. Johnson, J. Vlissides - Design Patterns: Elements of Reusable Object-Oriented Software, Addison-Wesley, 1994",
    "FOWLER": "M. Fowler - UML Distilled, Addison-Wesley",
    "MILES": "R. Miles, K. Hamilton - Learning UML 2.0, O'Reilly, 2006",
    "UMLCLASS": "M. Seidl, M. Scholz, C. Huemer, G. Kappel - UML @ Classroom, Springer, 2015",
    "MARTIN": "R. C. Martin - Clean Architecture: A Craftsman's Guide to Software Structure and Design, Prentice Hall, 2017 (riferimento extra, non tra i testi indicati dal prof)"
  },
  "nota_esame": "Scheda ufficiale 2026/27 [S1]: scritto di 2 ore e tesina individuale; i pesi 30%/55%/55% sommano 140% e sono incoerenti, quindi non calcolare un voto. La pagina docente [S2] descrive il programma, non il formato. La prova del 13/01/2017 [S6] è una trascrizione di terzi; fac-simile, prova 2025 e 13 prove 2017–2025 sono materiale o sintesi dell'utente [D1], non originali verificati. Le modalità restano separate: vedi docs/EXAM_FORMAT.md e docs/SYLLABUS.md.",
  "trappole": [
    {
      "tema": "Es. 1.4 - pattern",
      "fonte": "fac-simile 2016/17 fornito dall'utente; prove storiche secondo la sintesi dell'utente [D1]",
      "trappola": "Il testo non nomina mai il pattern: descrive uno scenario.",
      "risposta": "Riconosci lo scenario: gerarchia parte-tutto → Composite; accessori opzionali con costo → Decorator; algoritmo a passi fissi con varianti → Template Method; evento che notifica un insieme variabile di interessati → Observer. Motiva la scelta e indica i limiti."
    },
    {
      "tema": "Ottimizzazione del codice",
      "fonte": "prova 9/6/2022, sintesi dell'utente [D1]",
      "trappola": "Dire che la velocità va ottimizzata fin dall'inizio.",
      "risposta": "Knuth: 'premature optimization is the root of all evil'. Make it work, make it right, make it fast: si ottimizza dopo il profiling, solo sui veri colli di bottiglia, senza sacrificare leggibilità."
    },
    {
      "tema": "Errori nei requisiti",
      "fonte": "prova 9/6/2022, sintesi dell'utente [D1]",
      "trappola": "Dire che gli errori di analisi si correggono facilmente in programmazione.",
      "risposta": "Curva di Boehm: il costo di correzione cresce lungo il ciclo di vita (fino a ~100 volte in produzione). Prevenzione: review delle specifiche, prototipi, coinvolgimento degli stakeholder."
    },
    {
      "tema": "Coesione dei componenti",
      "fonte": "prove 9/6/2022 e 27/1/2023, sintesi dell'utente [D1]",
      "trappola": "Rispondere con la coesione delle classi invece che dei componenti.",
      "risposta": "Enuncia REP (granulo di riuso = granulo di rilascio), CCP (classi che cambiano insieme stanno insieme, SRP sui componenti), CRP (non dipendere da ciò che non usi, ISP sui componenti) e la loro tensione."
    },
    {
      "tema": "Black box a scaglioni",
      "fonte": "testing black box nelle 13 prove secondo la sintesi dell'utente [D1]",
      "trappola": "Dimenticare le classi non valide o fare la BVA su tutti i parametri quando ne è chiesto uno solo.",
      "risposta": "Classi valide e non valide per ogni parametro; test minimi: una classe non valida per test, le valide combinate; BVA solo sui casi validi e solo sul parametro richiesto (es. 'numero' nel 5/11/2025)."
    },
    {
      "tema": "Coerenza tra diagrammi",
      "fonte": "fac-simile 2016/17 fornito dall'utente e prova 5/11/2025, sintesi dell'utente [D1]",
      "trappola": "Sequence/activity/state con oggetti o metodi che non esistono nel class diagram.",
      "risposta": "Ogni lifeline è un'istanza di una classe progettata; ogni messaggio è un'operazione di quella classe."
    },
    {
      "tema": "Simple Factory e static",
      "fonte": "prova 5/11/2025, sintesi dell'utente [D1]",
      "trappola": "Chiamarla Factory Method o non discutere lo static.",
      "risposta": "È una Simple Factory (non un pattern GoF). Static: comodo, senza istanza, ma non si può sottoclassare né sostituire nei test."
    },
    {
      "tema": "White box",
      "fonte": "prove 2022, 2023 e 5/11/2025, sintesi dell'utente [D1]",
      "trappola": "Confondere statement coverage con decision coverage (un while va percorso sia vero sia falso).",
      "risposta": "Disegna il CFG; statement = ogni nodo; decision = ogni ramo vero/falso di ogni if/while; MC/DC = ogni condizione influenza da sola l'esito."
    }
  ],
